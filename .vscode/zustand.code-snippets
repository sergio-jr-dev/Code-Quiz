{
  "Zustand store with devtools": {
    "scope": "typescript,typescriptreact",
    "prefix": "zustand-store",
    "description": "Crea un store tipado de Zustand con StateCreator separado y devtools.",
    "body": [
      "import { create, type StateCreator } from 'zustand';",
      "import { devtools } from 'zustand/middleware';",
      "",
      "import type { ${1:StoreType} } from '${2:../types/store}';",
      "",
      "const ${3:storeName}Creator: StateCreator<${1:StoreType}> = (set) => ({",
      "  ${4:value: 0},",
      "",
      "  ${5:updateValue}: (${6:value}) => {",
      "    set((state) => ({",
      "      ${7:value: state.value + 1},",
      "    }));",
      "  },",
      "});",
      "",
      "export const use${8:StoreName}Store = create<${1:StoreType}>()(",
      "  devtools(${3:storeName}Creator, {",
      "    name: '${9:store-name}',",
      "  }),",
      ");",
      "",
    ],
  },
}
